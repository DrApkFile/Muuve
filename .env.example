# Names only. Supply secrets through your operator/deployment secret manager.
APP_ENV=local
APP_BASE_URL=
DATABASE_URL=
# Supabase session pooler: append sslmode=verify-full and
# sslrootcert=config/certs/supabase-prod-ca-2021.crt (run from repository root).
# Operator migration guard; use the actual project reference for a hosted database.
MUUVE_DATABASE_PROJECT_REF=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_RPC_URL_FALLBACK=
MUUVE_PROGRAM_ID=
USDT_MINT=
TOKEN_PROGRAM_ID=
TREASURY_TOKEN_ACCOUNT=
# Default 48 hours. Owner-approved preview demo: 240 only after the program
# upgrade and admin set_claim_window have been reviewed and verified on devnet.
CLAIM_WINDOW_SECS=172800
# Public role manifest for read-only verification (no private keys needed).
ADMIN_PUBLIC_KEY=
ATTESTOR_PUBLIC_KEY=
FEE_PAYER_PUBLIC_KEY=
TREASURY_OWNER_PUBLIC_KEY=
TEST_MINT_AUTHORITY_PUBLIC_KEY=
FEE_PAYER_SECRET=
# Local alternative to JSON values: restricted files, never upload keys/ to Render.
FEE_PAYER_SECRET_FILE=
ATTESTOR_SECRET=
ATTESTOR_SECRET_FILE=
ATTESTOR_KEYRING=
TREASURY_SECRET=
TREASURY_SECRET_FILE=
TREASURY_KEYRING=
TEST_MINT_AUTHORITY_SECRET=
TEST_MINT_AUTHORITY_SECRET_FILE=
SESSION_SECRET=
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PRIVATE_KEY_FILE=
AUTH_JWT_KID=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
OTP_PROVIDER=mock
# Hosted alternatives: twilio or textbee. Textbee is SMS-only and uses the
# existing SESSION_SECRET for challenge-bound HMAC verifiers (never plaintext OTP).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional explicit Android SIM subscription ID.
TEXTBEE_SIM_SUBSCRIPTION_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_OTP_ENABLED=false
PAYOUT_PROVIDER=mock
RATE_PROVIDER=mock
MOCK_NGN_PER_USD=1520
MOCK_WEBHOOK_SECRET=
CRON_SECRET=
TRUSTED_PROXY=false
# Background worker only, milliseconds; allowed range 1000–5000.
WORKER_POLL_MS=2000
# Operator-only local setup. Never put these in Render API/worker environments.
OPERATOR_ADMIN_SECRET_FILE=
OPERATOR_DEPLOYMENT_SECRET_FILE=
TEST_MINT_SECRET_FILE=
DEVNET_TEST_SENDER_SECRET_FILE=
DEVNET_TEST_CLAIM_SECRET_FILE=
DEVNET_TEST_RECIPIENT=
# Opt in explicitly when executing the operator transaction scripts.
OPERATOR_APPROVED_DEVNET=
MUUVE_ALLOW_CONFIG_CHANGE=
MUUVE_RUN_DEVNET_TRANSACTIONS=
MUUVE_DEVNET_EXPIRED_LINK_PDA=
MUUVE_DEVNET_RESUME_EVIDENCE=
SBF_TOOLCHAIN_ROOT=
